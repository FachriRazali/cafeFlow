# Copy this file to .env.local and fill in your own Postgres connection string
# (e.g. from Neon's dashboard → Connection Details, or your own Postgres instance).
# .env.local is gitignored — never commit real credentials.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Secret used to sign the login session cookie (web/src/lib/session.ts).
# Change this to a long random string before deploying for real — anyone who
# knows this value can forge a staff session.
SESSION_SECRET=change-this-to-a-long-random-string
